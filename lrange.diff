+# Tests for [lrange] where an index is not a literal known at compile time.
+# These are compiled to the listRange instruction and must behave exactly as
+# the command does (including error messages).
+test lrange-6.1 {lrange with variable indices} -body {
+    apply {{l a b} {lrange $l $a $b}} {a b c d e} 1 3
+} -result {b c d}
+test lrange-6.2 {lrange with variable last index} -body {
+    apply {{l b} {lrange $l 1 $b}} {a b c d e} end-1
+} -result {b c d}
+test lrange-6.3 {lrange with variable first index} -body {
+    apply {{l a} {lrange $l $a end}} {a b c d e} 2
+} -result {c d e}
+test lrange-6.4 {lrange with end-$n} -body {
+    apply {{l n} {lrange $l 1 end-$n}} {a b c d e} 2
+} -result {b c}
+test lrange-6.5 {lrange with variable indices: result is independent} -body {
+    apply {{i j} {
+	set l [list a b c d]
+	set r [lrange $l $i $j]
+	lappend r X
+	list $l $r
+    }} 1 2
+} -result {{a b c d} {b c X}}
+test lrange-6.6 {lrange with variable indices: not a list} -body {
+    apply {{l i j} {lrange $l $i $j}} "a \{ b" 0 1
+} -returnCodes error -result {unmatched open brace in list}
+test lrange-6.7 {lrange with variable indices: list is checked first} -body {
+    apply {{l i j} {lrange $l $i $j}} "a \{ b" foo 1
+} -returnCodes error -result {unmatched open brace in list}
+test lrange-6.8 {lrange with variable indices: bad first index} -body {
+    apply {{l i j} {lrange $l $i $j}} {a b c} foo 1
+} -returnCodes error -result {bad index "foo": must be integer?[+-]integer? or end?[+-]integer?}
+test lrange-6.9 {lrange with variable indices: bad last index} -body {
+    apply {{l i j} {lrange $l $i $j}} {a b c} 0 bar
+} -returnCodes error -result {bad index "bar": must be integer?[+-]integer? or end?[+-]integer?}
+test lrange-6.10 {lrange: literal invalid index is still a run time error} -body {
+    apply {{l} {lrange $l 0 rubbish}} {a b c}
+} -returnCodes error -result {bad index "rubbish": must be integer?[+-]integer? or end?[+-]integer?}
+test lrange-6.11 {lrange with variable indices: wrong # args} -body {
+    apply {{l i} {lrange $l $i}} {a b c} 1
+} -returnCodes error -result {wrong # args: should be "lrange list first last"}
+test lrange-6.12 {lrange with variable indices: redefinition is honoured} -setup {
+    namespace eval lrtest {
+	proc t {l i j} {lrange $l $i $j}
+    }
+    lrtest::t {a b c} 0 1
+} -body {
+    namespace eval lrtest {
+	proc lrange args {return redefined}
+    }
+    lrtest::t {a b c} 0 1
+} -cleanup {
+    namespace delete lrtest
+} -result redefined
+test lrange-6.13 {lrange with variable indices: compiled matches command} -body {
+    apply {{} {
+	set lss {{} {a} {a b c} {a b c d} "a {b c} d" "a \{ b"}
+	set idxs {-2 -1 0 1 2 3 end-3 end-2 end-1 end end+1 end+2 foo {} end- 1.5
+	    0x1 +1 end--1 10000000000000000000}
+	set lrange lrange
+	set bad {}
+	foreach l $lss {
+	    foreach a $idxs {
+		foreach b $idxs {
+		    set c1 [catch {lrange $l $a $b} r1]
