+		    if {$c1 != $c2 || $r1 ne $r2} {
+			lappend bad [list $l $a $b $c1 $r1 $c2 $r2]
+		    }
+		}
+	    }
+	}
+	set bad
+    }}
+} -result {}
+test lrange-6.14 {lrange with variable indices: used inside expressions and loops} -body {
+    apply {{l} {
